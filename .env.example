# Copy this file to backend/.env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Admin Setup ───────────────────────────────────────────────────────────────
# Used only on the first run of python init_db.py to create the admin account.
ADMIN_INITIAL_PASSWORD=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # use a strong password in production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vidushi_meta_saas

# ── App Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8009

# ── Backend public URL (Twilio/WhatsApp webhook callbacks) ───────────────────
BACKEND_PUBLIC_URL=http://localhost:8009

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2025-08-28

# ── Twilio (optional — can also be set in Settings UI) ───────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── VoBiz SIP trunk (optional) ───────────────────────────────────────────────
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_SIP_DOMAIN=
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=

# ── Misc ──────────────────────────────────────────────────────────────────────
SSL_VERIFY=true   # set false only behind a corporate proxy in local dev
