# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in your real values
# NEVER commit .env to git — it contains secrets
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin Setup (used only when running init_db.py for the first time) ────────
ADMIN_INITIAL_PASSWORD=choose_a_strong_password_here

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vidushi_meta_saas

# ── App Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_char_hex_secret_key_here

# Shared secret between agent.py and internal backend endpoints (book-appointment, livekit-event, inbound-*)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=generate_a_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet encryption key for API keys stored in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_fernet_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── LiveKit ───────────────────────────────────────────────────────────────────
# From: https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LiveKit SIP Outbound Trunk ID — only needed if you're pasting in a manually-built
# Twilio trunk. With VoBiz, leave this blank: Settings → Calling Provider → Activate
# VoBiz creates/updates it for you automatically.
# From: LiveKit Dashboard → SIP → Outbound Trunks
LIVEKIT_SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxxx

# ── VoBiz (SIP trunk provider, 130+ countries) ────────────────────────────────
# NOT read from here by the backend — VoBiz credentials are only ever read from
# the database (set via Settings → Calling Provider → VoBiz in the app, where you
# also click "Activate VoBiz" to auto-provision the matching LiveKit SIP trunk).
# Listed here only so this file documents every credential the app uses somewhere.
# From: console.vobiz.ai → SIP Trunk settings
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_SIP_DOMAIN=
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# From: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Gemini model for voice (native audio — handles STT + LLM + TTS in one)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ── Twilio (SMS/WhatsApp + SIP trunk for phone calls) ────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# ── Google Calendar (optional) ────────────────────────────────────────────────
# Path to your Google service account JSON file (keep outside project root)
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service_account.json

# ── Webhook ───────────────────────────────────────────────────────────────────
# The public URL of this backend — used by LiveKit to post call completion events
# Use ngrok for local dev: https://your-tunnel.ngrok.io
BACKEND_PUBLIC_URL=https://your-domain.com
